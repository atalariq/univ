{
  "$schema": "https://opencode.ai/config.json",
  // Aturan proyek untuk agen, dipakai juga oleh alat lain yang membaca AGENTS.md.
  "instructions": ["AGENTS.md"],
  // Lokasi kode praktikum. Path ini spesifik mesin pemilik repo, jadi clone di
  // mesin lain perlu menyesuaikannya. Penjelasan lengkap ada di AGENTS.md tiap
  // mata kuliah.
  "references": {
    "ppwl-code": {
      "path": "~/Works/ppwl-laprak/code",
      "description": "Kode portofolio PPWL, satu proyek lintas pertemuan dengan branch per praktikum"
    },
    "pppbd-code": {
      "path": "~/AndroidStudioProjects",
      "description": "Proyek Android PPPBD, satu repo per pertemuan"
    }
  }
}
