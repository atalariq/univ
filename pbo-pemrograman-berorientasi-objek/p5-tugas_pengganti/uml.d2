  "+tampilInfo()": ""
  "+hitungBiaya()": ""
  "+tampilDetail()": ""
}

Motor: {
  shape: class
  "-tipeTransmisi": ""
  "+tampilInfo()": ""
  "+hitungBiaya()": ""
  "+tampilDetail()": ""
}

Bus: {
  shape: class
  "-kapasitasPenumpang": ""
  "+tampilInfo()": ""
  "+hitungBiaya()": ""
  "+tampilDetail()": ""
}

Mobil -> Kendaraan: extends {
  target-arrowhead: {
    shape: triangle
    style.filled: false
  }
}

Motor -> Kendaraan: extends {
  target-arrowhead: {
    shape: triangle
    style.filled: false
  }
}

