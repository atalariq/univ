Kendaraan: {
  shape: class
  "<<abstract>>": ""
  "-nomorKendaraan": ""
  "-merk": ""
  "-tahunProduksi": ""
  "-status": ""
  "+ubahStatus()": ""
  "+tampilInfo()": ""
  "+hitungBiaya()": ""
}

Sewa: {
  shape: class
  "<<interface>>": ""
  "+hitungBiaya()": ""
  "+tampilDetail()": ""
}

