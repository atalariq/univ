#!/usr/bin/env python3
"""
cheatsheet-generator — Generate markdown cheatsheets from Typst notes or laprak materials.

Usage:
    cheatsheet-generator <source-path> [--output <output.md>] [--format markdown|pdf]

Examples:
    # Generate from a single typst file
    cheatsheet-generator pbo/2026-06-09-cheatsheet-uas/cheatsheet.typ

    # Generate from all .typ files in a directory
    cheatsheet-generator statistika/2026-06-10-persiapan-uas/ --output cheatsheet.md

    # Generate from a laprak folder (extracts key points from report.typ)
    cheatsheet-generator ppw1/p12-php_crud/

Features:
    - Extracts headings, key terms, code blocks, and bullet points from .typ files
    - Handles Typst markup (bold, italic, headings, lists, code blocks)
    - Merges multiple .typ files into a single cheatsheet
    - Outputs clean, well-formatted markdown
"""

import sys
import os
import re
import argparse
from pathlib import Path


def to_kebab(text: str) -> str:
    """Convert text to kebab-case."""
    text = text.lower()
    text = re.sub(r'[^a-z0-9\s-]', '', text)
    text = re.sub(r'\s+', '-', text)
    text = re.sub(r'-+', '-', text)
    return text.strip('-')


def collect_typ_files(path: Path) -> list[Path]:
    """Collect .typ files from a directory or single file."""
    if path.is_file() and path.suffix == '.typ':
        return [path]
    if path.is_dir():
        files = sorted(path.glob('*.typ'))
        # Prefer report.typ first, then main.typ, then others
        priority = []
        rest = []
        for f in files:
            if f.name == 'report.typ':
                priority.insert(0, f)
            elif f.name == 'main.typ':
                priority.append(f)
            else:
                rest.append(f)
        return priority + rest
    return []


def extract_typ_content(text: str) -> str:
    """Process Typst content into markdown.

    Handles:
    - Headings (=, ==, ===, ====)
    - Bold (*text*)
    - Italic (_text_)
    - Bullet lists (+ or -)
    - Numbered lists (+ or 1.)
    - Code blocks (```)
    - Inline code (`)
    - Comments (//, /* */)
    - Terms (/ term: description)
    - Labels and references
    - Images
    - Tables
    - Imports, show rules, set rules
    """
    lines = text.split('\n')
    output_lines = []
    in_code_block = False
    in_multiline_comment = False
    in_show_block = False
    show_paren_depth = 0

    for line in lines:
        stripped = line.strip()

        # Handle multiline comments
        if in_multiline_comment:
            if '*/' in stripped:
                in_multiline_comment = False
            continue
        if stripped.startswith('/*'):
            if '*/' not in stripped:
                in_multiline_comment = True
            continue

        # Skip single-line comments
        if stripped.startswith('//'):
            continue

        # Track show: blocks — skip everything until balanced parens
        if in_show_block:
            show_paren_depth += stripped.count('(') - stripped.count(')')
            if show_paren_depth <= 0:
                in_show_block = False
                show_paren_depth = 0
            continue
        if re.match(r'^#(show|let)\b.*\(', stripped):
            in_show_block = True
            show_paren_depth = stripped.count('(') - stripped.count(')')
            if show_paren_depth <= 0:
                in_show_block = False
                show_paren_depth = 0
            continue

        # Code blocks
        if '```' in stripped:
            output_lines.append(line)
            in_code_block = not in_code_block
            continue

        if in_code_block:
            output_lines.append(line)
            continue

        # Skip empty lines
        if not stripped:
            output_lines.append('')
            continue

        # Skip imports, show/set rules, and metadata
        if re.match(r'^#(import|show|set|let)\b', stripped):
            continue
        if stripped.startswith('#metadata'):
            continue
        if stripped.startswith('#label'):
            continue
        if stripped.startswith('#pagebreak'):
            output_lines.append('')
            continue
        if re.match(r'^#(include-code|code|img|image|figure|tbl|table|col|v|daftar-isi|daftar-gambar|daftar-tabel|bibliography)\b', stripped):
            continue
        # Skip function arguments / metadata lines (field: value, at top level)
        if re.match(r'^[a-z][a-z-]*:\s*"[^"]*"', stripped):
            continue
        if re.match(r'^[a-z][a-z-]*:\s*\d+', stripped):
            continue
        if re.match(r'^[a-z][a-z-]*:\s*(true|false|none)\b', stripped):
            continue

        # Handle headings (=, ==, ===, ====)
        heading_match = re.match(r'^(=+)\s+(.+)', stripped)
        if heading_match:
            level = len(heading_match.group(1))
            title = heading_match.group(2).strip()
            # Convert to markdown heading (max level 4)
            md_level = min(level, 4)
            prefix = '#' * md_level
            output_lines.append(f'\n{prefix} {title}\n')
            continue

        # Handle term definitions (/ term: description)
        term_match = re.match(r'^/\s+(.+?):\s*(.*)', stripped)
        if term_match:
            term = term_match.group(1).strip()
            desc = term_match.group(2).strip()
            output_lines.append(f'**{term}:** {desc}')
            continue

        # Handle bullet lists (+ or -)
        list_match = re.match(r'^(\+|-)\s+(.+)', stripped)
        if list_match:
            content = list_match.group(2)
            output_lines.append(f'- {content}')
            continue

        # Handle inline formatting
        processed = stripped
        # Bold: *text*
        processed = re.sub(r'\*(.+?)\*', r'**\1**', processed)
        # Italic: _text_
        processed = re.sub(r'_(.+?)_', r'*\1*', processed)
        # Inline code: `text`
        processed = re.sub(r'`([^`]+)`', r'`\1`', processed)
        # Links: #link("url")[text]
        processed = re.sub(r'#link\("[^"]*"\)\[(.+?)\]', r'\1', processed)
        # Citations: @key
        processed = re.sub(r'@(\w+)', r'[\1]', processed)
        # Remove inline labels and refs
        processed = re.sub(r'#<\w+>', '', processed)
        processed = re.sub(r'@\w+', '', processed)

        # Skip image/figure lines
        if re.match(r'^#(img|image|figure)\b', processed):
            continue
        if re.match(r'^#(tbl|table|col|code)\b', processed):
            continue
        if re.match(r'^#(daftar-isi|daftar-gambar|daftar-tabel)', processed):
            continue
        if re.match(r'^#v\(', processed):
            continue

        output_lines.append(processed)

    return '\n'.join(output_lines)


def generate_cheatsheet(sources: list[Path], output_path: Path, title: str = None) -> str:
    """Generate a markdown cheatsheet from typst sources."""
    sections = []

    if not sources:
        return "# Cheatsheet\n\n_No Typst sources found._\n"

    # Collect content from each source
    for src in sources:
        with open(src, 'r') as f:
            content = f.read()

        extracted = extract_typ_content(content)

        # Skip if empty after extraction
        if not extracted.strip():
            continue

        # Add section header
        section_title = src.stem.replace('-', ' ').replace('_', ' ').title()
        if section_title.lower() in ('report', 'main', 'template', 'cheatsheet'):
            section_title = Path(src.parent).name.replace('-', ' ').title()

        sections.append(f'## Source: {src.parent.name}/{src.name}\n\n{extracted}\n')

    if not sections:
        return "# Cheatsheet\n\n_No extractable content found._\n"

    # Build final document
    doc_title = title or f"Cheatsheet — {Path(sources[0].parent).name.replace('-', ' ').title()}"
    header = f'# {doc_title}\n\n> Generated from {len(sources)} Typst source(s)\n\n---\n\n'

    return header + '\n---\n\n'.join(sections)


def main():
    parser = argparse.ArgumentParser(
        description='Generate markdown cheatsheets from Typst notes or laprak materials.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s pbo/2026-06-09-cheatsheet-uas/cheatsheet.typ
  %(prog)s statistika/2026-06-10-persiapan-uas/ --output cheatsheet.md
  %(prog)s ppw1-praktikum-pemrograman-web-1/p12-php_crud/
        """
    )
    parser.add_argument(
        'source',
        help='Path to a .typ file or directory containing .typ files'
    )
    parser.add_argument(
        '-o', '--output',
        default=None,
        help='Output file path (default: stdout or <source-dir>/cheatsheet.md)'
    )
    parser.add_argument(
        '--title',
        default=None,
        help='Title for the cheatsheet (default: auto-generated)'
    )
    parser.add_argument(
        '--format',
        choices=['markdown', 'pdf'],
        default='markdown',
        help='Output format (default: markdown)'
    )

    args = parser.parse_args()
    source_path = Path(args.source).resolve()

    if not source_path.exists():
        print(f"Error: Path does not exist: {source_path}", file=sys.stderr)
        sys.exit(1)

    # Collect typ files
    typ_files = collect_typ_files(source_path)
    if not typ_files:
        print(f"Error: No .typ files found at: {source_path}", file=sys.stderr)
        sys.exit(1)

    print(f"Found {len(typ_files)} Typst source(s):", file=sys.stderr)
    for f in typ_files:
        print(f"  - {f}", file=sys.stderr)

    # Generate cheatsheet
    cheatsheet = generate_cheatsheet(typ_files, source_path, args.title)

    # Determine output path
    if args.output:
        output_path = Path(args.output)
    elif source_path.is_dir():
        output_path = source_path / 'cheatsheet.md'
    else:
        output_path = source_path.with_suffix('.md')

    # Write output
    with open(output_path, 'w') as f:
        f.write(cheatsheet)

    print(f"\nCheatsheet written to: {output_path}", file=sys.stderr)
    print(f"Size: {output_path.stat().st_size} bytes", file=sys.stderr)


if __name__ == '__main__':
    main()
