#!/usr/bin/env bash
# =============================================================================
# laprak — Lab Report (Laprak) scaffolding and utilities
#
# Usage: laprak <subcommand> [args...]
#
# Subcommands:
#   new <course-abbr> <course-name> <meeting-num> <topic>
#     Scaffold a new laprak project (report.typ + references.bib + assets/logo.png symlink)
#     Example: laprak new ppw1 Praktikum-Pemrograman-Web-1 12 php-crud
#
#   paste-img [name]
#     Paste clipboard image into current directory (uses wl-paste)
#     Example: laprak paste-img screenshot
#
#   ripdrag [target-dir]
#     Open ripdrag to drag files into target directory (defaults to .)
#     Example: laprak ripdrag assets
#
#   tidy-up
#     Clean temporary files and organize current laprak directory
#     Example: laprak tidy-up
# =============================================================================

set -euo pipefail

# ─── Configuration ───────────────────────────────────────────────────────────
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SHARED_LOGO="$REPO_ROOT/.templates/report-typst/assets/logo.png"
TEMPLATE_DIR="$REPO_ROOT/.templates/report-typst"
SCRIPT_NAME="$(basename "$0")"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ─── Helpers ─────────────────────────────────────────────────────────────────
die() { echo -e "${RED}Error:${NC} $*" >&2; exit 1; }
info() { echo -e "${BLUE}→${NC} $*"; }
ok() { echo -e "${GREEN}✓${NC} $*"; }
warn() { echo -e "${YELLOW}⚠${NC} $*"; }

# Kebab-case conversion
to_kebab() {
    echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//g' | sed 's/-$//g'
}

# Zero-padded number
pad_num() {
    printf "%02d" "$1"
}

# ─── Subcommand: new ─────────────────────────────────────────────────────────
cmd_new() {
    local course_abbr="$1"
    local course_name="$2"
    local meeting_num="$3"
    local topic="$4"

    # Validate inputs
    [[ -z "$course_abbr" ]] && die "Missing <course-abbr> argument"
    [[ -z "$course_name" ]] && die "Missing <course-name> argument"
    [[ -z "$meeting_num" ]] && die "Missing <meeting-num> argument"
    [[ -z "$topic" ]] && die "Missing <topic> argument"

    # Normalize to kebab-case (AGENTS.md convention)
    local abbr_kebab
    abbr_kebab="$(to_kebab "$course_abbr")"
    local name_kebab
    name_kebab="$(to_kebab "$course_name")"
    local topic_kebab
    topic_kebab="$(to_kebab "$topic")"

    # Course folder: <abbr>-<full-name>
    local course_dir="$abbr_kebab-$name_kebab"

    # Meeting folder: p##-topic (zero-padded)
    local meeting_padded
    meeting_padded="$(pad_num "$meeting_num")"
    local meeting_dir="p${meeting_padded}-${topic_kebab}"

    # Full path
    local full_path="$REPO_ROOT/$course_dir/$meeting_dir"

    if [[ -d "$full_path" ]]; then
        die "Directory already exists: $full_path"
    fi

    # Create directory structure
    info "Scaffolding laprak at: $full_path"
    mkdir -p "$full_path/assets"
    mkdir -p "$full_path/modules"

    # Copy template files from .templates/report-typst/
    if [[ -f "$TEMPLATE_DIR/template.typ" ]]; then
        cp "$TEMPLATE_DIR/template.typ" "$full_path/template.typ"
        ok "Copied template.typ"
    else
        warn "template.typ not found at $TEMPLATE_DIR/template.typ"
    fi

    if [[ -f "$TEMPLATE_DIR/references.bib" ]]; then
        cp "$TEMPLATE_DIR/references.bib" "$full_path/references.bib"
        ok "Copied references.bib"
    else
        # Create empty references.bib
        touch "$full_path/references.bib"
        info "Created empty references.bib"
    fi

    # Symlink logo.png from shared location
    if [[ -f "$SHARED_LOGO" ]]; then
        ln -s "$(realpath --relative-to="$full_path/assets" "$SHARED_LOGO")" "$full_path/assets/logo.png"
        ok "Symlinked assets/logo.png → shared logo"
    else
        warn "Shared logo not found at $SHARED_LOGO"
    fi

    # Create report.typ from template
    local course_title
    course_title="$(echo "$course_name" | sed 's/-/ /g')"
    local meeting_title
    meeting_title="$(echo "$topic" | sed 's/-/ /g')"

    cat > "$full_path/report.typ" <<TYPTEMPLATE
#import "@local/report:1.0.0": *

#show: report.with(
  author: "Atalariq Barra Hadinugraha",
  id: "25/557554/SV/26192",
  class: "B2",
  course: "$course_title",
  course-code: "<course-code>",
  lecturer: "<lecturer-name>",
  meeting: "$meeting_num",
  title: "$meeting_title",
  use-cover: true,
  bib: bibliography("references.bib"),
  font: "Times New Roman",
  code-font: "Fira Code",
  font-size: 12pt,
)

#set par(justify: true)
#set par(first-line-indent: (amount: 0.5in, all: true))

#daftar-isi()
// #daftar-gambar()
// #daftar-tabel()

= Tujuan Praktikum

+ <tujuan-1>
+ <tujuan-2>
+ <tujuan-3>

= Dasar Teori

== <sub-bab-1>

<isi>

== <sub-bab-2>

<isi>

= Hasil dan Pembahasan

== <langkah-1>

<penjelasan-dan-kode>

== <langkah-2>

<penjelasan-dan-kode>

= Kesimpulan

+ <kesimpulan-1>
+ <kesimpulan-2>
+ <kesimpulan-3>
TYPTEMPLATE

    ok "Created report.typ"

    # Create typst.toml if needed (for @local package resolution)
    if [[ ! -f "$course_dir/typst.toml" ]]; then
        # Don't create -- user should handle package resolution
        info "Note: Ensure @local/report package is linked (see ~/Repos/typst-packages/packages/)"
    fi

    echo ""
    ok "Laprak scaffolded successfully!"
    echo ""
    echo "  Directory: $full_path"
    echo "  Files:"
    echo "    ├── report.typ"
    echo "    ├── references.bib"
    echo "    ├── template.typ"
    echo "    ├── modules/"
    echo "    └── assets/"
    echo "        └── logo.png → (symlink to shared)"
    echo ""
    echo "  Next steps:"
    echo "    1. Edit report.typ with actual content"
    echo "    2. Update course-code and lecturer-name"
    echo "    3. Compile with: typst compile report.typ"
}

# ─── Subcommand: paste-img ───────────────────────────────────────────────────
cmd_paste_img() {
    local name="${1:-clipboard}"

    # Check for clipboard tools
    local paste_cmd=""
    if command -v wl-paste &>/dev/null; then
        paste_cmd="wl-paste"
    elif command -v xclip &>/dev/null; then
        paste_cmd="xclip -selection clipboard -t image/png -o"
    else
        die "No clipboard tool found. Install wl-paste (wl-clipboard) or xclip."
    fi

    # Generate filename with timestamp
    local timestamp
    timestamp="$(date +%Y-%m-%d_%H%M%S)"
    local filename="${timestamp}-${name}.png"
    local output_path="${PWD}/${filename}"

    info "Pasting clipboard image to: $output_path"

    if [[ "$paste_cmd" == "wl-paste" ]]; then
        wl-paste -t image/png > "$output_path" 2>/dev/null || die "Failed to paste image. Is there an image in clipboard?"
    else
        $paste_cmd > "$output_path" 2>/dev/null || die "Failed to paste image. Is there an image in clipboard?"
    fi

    # Verify it's a valid PNG
    if file "$output_path" | grep -q "PNG image"; then
        ok "Saved: $filename ($(du -h "$output_path" | cut -f1))"
    else
        warn "File doesn't appear to be a valid PNG image. Removing."
        rm -f "$output_path"
        die "Invalid image data in clipboard."
    fi
}

# ─── Subcommand: ripdrag ─────────────────────────────────────────────────────
cmd_ripdrag() {
    local target="${1:-.}"

    if ! command -v ripdrag &>/dev/null; then
        die "ripdrag not found. Install it first."
    fi

    # Create target if it doesn't exist
    mkdir -p "$target"

    info "Opening ripdrag — drag files from your file manager into this terminal."
    info "Target directory: $(realpath "$target")"
    info "Press Ctrl+C when done."

    ripdrag "$target"
}

# ─── Subcommand: tidy-up ─────────────────────────────────────────────────────
cmd_tidy_up() {
    info "Tidying up current directory..."

    local cleaned=0

    # Remove common temp files
    local temp_patterns=(
        "*.aux"
        "*.log"
        "*.out"
        "*.toc"
        "*.synctex.gz"
        "*.fdb_latexmk"
        "*.fls"
        "*.bbl"
        "*.blg"
        "*.run.xml"
        "*-blx.bib"
    )

    for pattern in "${temp_patterns[@]}"; do
        # shellcheck disable=SC2086
        if compgen -G "$pattern" > /dev/null 2>&1; then
            rm -f $pattern
            cleaned=$((cleaned + 1))
            info "Removed: $pattern"
        fi
    done

    # Clean Typst artifacts
    if [[ -d ".typst" ]]; then
        rm -rf .typst
        cleaned=$((cleaned + 1))
        info "Removed: .typst/"
    fi

    # Organize images into assets/ if they're in the root
    if [[ -d "assets" ]]; then
        local img_count=0
        shopt -s nullglob
        for img in *.png *.jpg *.jpeg *.gif *.webp; do
            [[ -f "$img" ]] || continue
            mv "$img" "assets/"
            img_count=$((img_count + 1))
        done
        shopt -u nullglob
        if [[ $img_count -gt 0 ]]; then
            info "Moved $img_count image(s) to assets/"
            cleaned=$((cleaned + img_count))
        fi
    fi

    # Remove leftover empty temp dirs
    find . -type d -empty -name "tmp*" -delete 2>/dev/null || true

    if [[ $cleaned -eq 0 ]]; then
        ok "Nothing to tidy up. Directory is clean."
    else
        ok "Cleaned up $cleaned item(s)."
    fi
}

# ─── Main ────────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage: $SCRIPT_NAME <subcommand> [args...]

Subcommands:
  new <course-abbr> <course-name> <meeting-num> <topic>
      Scaffold a new laprak project.
      Example: laprak new ppw1 Praktikum-Pemrograman-Web-1 12 php-crud

  paste-img [name]
      Paste clipboard image to file (PNG format).
      Example: laprak paste-img screenshot

  ripdrag [target-dir]
      Open ripdrag to drag files into target directory.
      Example: laprak ripdrag assets

  tidy-up
      Clean temporary files and organize current laprak directory.

Conventions (from AGENTS.md):
  - lowercase, kebab-case for all names
  - Zero-padded numeric prefixes (p01, p02, ...)
  - No spaces, no parentheses
EOF
}

main() {
    local subcommand="${1:-}"
    shift || true

    case "$subcommand" in
        new)
            cmd_new "${1:-}" "${2:-}" "${3:-}" "${4:-}"
            ;;
        paste-img)
            cmd_paste_img "${1:-}"
            ;;
        ripdrag)
            cmd_ripdrag "${1:-}"
            ;;
        tidy-up)
            cmd_tidy_up
            ;;
        -h|--help|help|"")
            usage
            ;;
        *)
            die "Unknown subcommand: $subcommand\n       Run '$SCRIPT_NAME help' for usage."
            ;;
    esac
}

main "$@"
