#!/usr/bin/env bash
# =============================================================================
# optimize-images — Compress images and deduplicate logo.png in laprak folders
#
# Usage:
#   optimize-images [options] [path]
#
# Features:
#   - Compresses PNG, JPG, and JPEG images using ImageMagick (mogrify/convert)
#   - Detects duplicate logo.png files (by md5 hash) and replaces with symlinks
#     to a canonical shared copy
#   - Dry-run mode to preview changes without modifying files
#   - Recursive scanning of laprak folders
#
# Options:
#   --dry-run       Preview changes without modifying files
#   --no-symlink    Skip logo.png deduplication (compress only)
#   --quality N     JPEG/PNG quality (default: 85 for JPEG, adaptive for PNG)
#   --max-width N   Resize images wider than N pixels (default: 1920)
#   --help          Show this help
#
# Examples:
#   optimize-images                          # Optimize all images in repo
#   optimize-images ppw1/p12-php_crud/       # Optimize specific folder
#   optimize-images --dry-run                # Preview what would change
#   optimize-images --no-symlink             # Compress only, skip dedup
# =============================================================================

set -euo pipefail

# ─── Configuration ───────────────────────────────────────────────────────────
REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SHARED_LOGO="$REPO_ROOT/.templates/report-typst/assets/logo.png"
SHARED_LOGO_HASH=""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# ─── State ───────────────────────────────────────────────────────────────────
DRY_RUN=false
NO_SYMLINK=false
QUALITY=85
MAX_WIDTH=1920

COMPRESSED_COUNT=0
SYMLINKED_COUNT=0
SKIPPED_COUNT=0
BYTES_SAVED=0

# ─── Helpers ─────────────────────────────────────────────────────────────────
die() { echo -e "${RED}Error:${NC} $*" >&2; exit 1; }
info() { echo -e "${BLUE}→${NC} $*"; }
ok() { echo -e "${GREEN}✓${NC} $*"; }
warn() { echo -e "${YELLOW}⚠${NC} $*"; }
dry() { echo -e "${CYAN}[dry-run]${NC} $*"; }

# Check dependencies
check_deps() {
    local missing=()
    if ! command -v convert &>/dev/null && ! command -v magick &>/dev/null; then
        missing+=("ImageMagick (convert/magick)")
    fi
    if ! command -v mogrify &>/dev/null && ! command -v magick &>/dev/null; then
        # magick mogrify works as alternative
        :
    fi
    if [[ ${#missing[@]} -gt 0 ]]; then
        die "Missing required tools: ${missing[*]}"
    fi
}

# Get ImageMagick command prefix
magick_cmd() {
    if command -v magick &>/dev/null; then
        echo "magick"
    else
        echo ""
    fi
}

# Get shared logo hash
get_shared_logo_hash() {
    if [[ -n "$SHARED_LOGO_HASH" ]]; then
        echo "$SHARED_LOGO_HASH"
        return
    fi
    if [[ -f "$SHARED_LOGO" ]]; then
        SHARED_LOGO_HASH="$(md5sum "$SHARED_LOGO" | awk '{print $1}')"
        echo "$SHARED_LOGO_HASH"
    else
        die "Shared logo not found at: $SHARED_LOGO"
    fi
}

# Calculate relative path for symlink
relpath() {
    python3 -c "import os; print(os.path.relpath('$1', '$2'))"
}

# ─── Image Compression ───────────────────────────────────────────────────────
compress_image() {
    local file="$1"
    local original_size
    original_size="$(stat -c%s "$file" 2>/dev/null || echo 0)"

    if [[ "$original_size" -eq 0 ]]; then
        return
    fi

    local ext="${file##*.}"
    ext="${ext,,}" # lowercase

    local temp_file="${file}.optimized-tmp"

    if [[ "$DRY_RUN" == true ]]; then
        case "$ext" in
            png)
                dry "Would compress: $file (PNG, ${original_size} bytes)"
                ;;
            jpg|jpeg)
                dry "Would compress: $file (JPEG, ${original_size} bytes)"
                ;;
        esac
        return
    fi

    case "$ext" in
        png)
            # PNG: use adaptive quality with ImageMagick
            # Reduce colors to 256, strip metadata, optimize
            $(magick_cmd) convert "$file" \
                -strip \
                -resize "${MAX_WIDTH}x${MAX_WIDTH}>" \
                -colors 256 \
                -quality "$QUALITY" \
                "$temp_file" 2>/dev/null || return

            # Check if we actually saved space
            local new_size
            new_size="$(stat -c%s "$temp_file" 2>/dev/null || echo 0)"

            if [[ "$new_size" -gt 0 ]] && [[ "$new_size" -lt "$original_size" ]]; then
                mv "$temp_file" "$file"
                local saved=$((original_size - new_size))
                BYTES_SAVED=$((BYTES_SAVED + saved))
                COMPRESSED_COUNT=$((COMPRESSED_COUNT + 1))
                info "Compressed: $file (${original_size} → ${new_size} bytes, saved $saved bytes)"
            else
                rm -f "$temp_file"
                SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
            fi
            ;;
        jpg|jpeg)
            # JPEG: strip metadata and resize
            $(magick_cmd) mogrify \
                -strip \
                -resize "${MAX_WIDTH}x${MAX_WIDTH}>" \
                -quality "$QUALITY" \
                "$file" 2>/dev/null || return

            local new_size
            new_size="$(stat -c%s "$file" 2>/dev/null || echo 0)"
            if [[ "$new_size" -gt 0 ]] && [[ "$new_size" -lt "$original_size" ]]; then
                local saved=$((original_size - new_size))
                BYTES_SAVED=$((BYTES_SAVED + saved))
                COMPRESSED_COUNT=$((COMPRESSED_COUNT + 1))
                info "Compressed: $file (${original_size} → ${new_size} bytes, saved $saved bytes)"
            else
                SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
            fi
            ;;
        *)
            SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
            ;;
    esac
}

# ─── Logo Deduplication ──────────────────────────────────────────────────────
dedup_logos() {
    if [[ "$NO_SYMLINK" == true ]]; then
        info "Skipping logo deduplication (--no-symlink)"
        return
    fi

    local shared_hash
    shared_hash="$(get_shared_logo_hash)"

    local search_path="${1:-$REPO_ROOT}"

    info "Scanning for duplicate logo.png files..."

    # Find all logo.png files
    while IFS= read -r -d '' logo_file; do
        # Skip the shared logo itself
        if [[ "$(realpath "$logo_file")" == "$(realpath "$SHARED_LOGO")" ]]; then
            continue
        fi

        # Skip if already a symlink
        if [[ -L "$logo_file" ]]; then
            continue
        fi

        # Check hash
        local file_hash
        file_hash="$(md5sum "$logo_file" | awk '{print $1}')"

        if [[ "$file_hash" == "$shared_hash" ]]; then
            # Duplicate found — replace with symlink
            local original_size
            original_size="$(stat -c%s "$logo_file" 2>/dev/null || echo 0)"

            if [[ "$DRY_RUN" == true ]]; then
                local rel
                rel="$(relpath "$SHARED_LOGO" "$(dirname "$logo_file")")"
                dry "Would symlink: $logo_file → $rel"
                BYTES_SAVED=$((BYTES_SAVED + original_size))
                SYMLINKED_COUNT=$((SYMLINKED_COUNT + 1))
            else
                local logo_dir
                logo_dir="$(dirname "$logo_file")"
                local rel
                rel="$(relpath "$SHARED_LOGO" "$logo_dir")"

                # For git: remove the file and replace with symlink
                # First, check if it's tracked by git
                if git -C "$REPO_ROOT" ls-files --error-unmatch "$logo_file" &>/dev/null 2>&1; then
                    git -C "$REPO_ROOT" rm --cached "$logo_file" &>/dev/null
                fi

                rm -f "$logo_file"
                ln -s "$rel" "$logo_file"

                BYTES_SAVED=$((BYTES_SAVED + original_size))
                SYMLINKED_COUNT=$((SYMLINKED_COUNT + 1))
                ok "Symlinked: $logo_file → $rel"
            fi
        fi
    done < <(find "$search_path" -name "logo.png" -not -path "*/.git/*" -print0 2>/dev/null)
}

# ─── Main ────────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
Usage: $(basename "$0") [options] [path]

Compress images and deduplicate logo.png files in laprak folders.

Options:
  --dry-run       Preview changes without modifying files
  --no-symlink    Skip logo.png deduplication (compress only)
  --quality N     JPEG/PNG quality (default: 85)
  --max-width N   Resize images wider than N pixels (default: 1920)
  --help          Show this help

Examples:
  $(basename "$0")                              # Optimize all images in repo
  $(basename "$0") ppw1/p12-php_crud/           # Optimize specific folder
  $(basename "$0") --dry-run                    # Preview changes
EOF
}

main() {
    local search_path="$REPO_ROOT"

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --no-symlink)
                NO_SYMLINK=true
                shift
                ;;
            --quality)
                QUALITY="$2"
                shift 2
                ;;
            --max-width)
                MAX_WIDTH="$2"
                shift 2
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                search_path="$1"
                shift
                ;;
        esac
    done

    # Resolve path
    if [[ ! -d "$search_path" ]]; then
        search_path="$REPO_ROOT/$search_path"
    fi
    if [[ ! -d "$search_path" ]]; then
        die "Path does not exist: $search_path"
    fi

    check_deps

    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "  optimize-images — Image compression & logo deduplication"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    echo "  Path:       $search_path"
    echo "  Quality:    $QUALITY"
    echo "  Max width:  ${MAX_WIDTH}px"
    echo "  Dry run:    $DRY_RUN"
    echo "  Dedup logo: $(if $NO_SYMLINK; then echo 'no'; else echo 'yes'; fi)"
    echo ""

    # ─── Phase 1: Compress images ───────────────────────────────────
    info "Phase 1: Compressing images..."

    while IFS= read -r -d '' img_file; do
        compress_image "$img_file"
    done < <(find "$search_path" \
        -type f \
        \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" \) \
        -not -path "*/.git/*" \
        -not -name "*.optimized-tmp" \
        -print0 2>/dev/null)

    echo ""

    # ─── Phase 2: Deduplicate logos ──────────────────────────────────
    info "Phase 2: Deduplicating logo.png files..."
    dedup_logos "$search_path"

    # ─── Summary ─────────────────────────────────────────────────────
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    if [[ "$DRY_RUN" == true ]]; then
        echo "  DRY RUN — no changes made"
    fi
    echo "  Compressed:   $COMPRESSED_COUNT image(s)"
    echo "  Symlinked:    $SYMLINKED_COUNT logo(s)"
    echo "  Skipped:      $SKIPPED_COUNT image(s)"
    echo "  Bytes saved:  $BYTES_SAVED ($((BYTES_SAVED / 1024)) KB)"
    echo "═══════════════════════════════════════════════════════════════"
}

main "$@"
