#!/usr/bin/env bash
# =============================================================================
# setup-typst-packages — link @local Typst packages used by laprak reports
#
# Idempotent. Run once per machine (e.g. after cloning this repo).
#
#   @local/lab-report:1.0.0  → ~/Repos/typst-packages/packages/lab-report/1.0.0
#   @local/lab-report:2.0.0  → ~/Repos/typst-packages/packages/lab-report/2.0.0
#   @local/report:1.0.0      → <this repo>/.templates/report-typst   (backward compat)
#
# Old reports import @local/report:1.0.0; new reports (laprak new) import
# @local/lab-report:2.0.0. Both are linked so every report keeps compiling.
# =============================================================================

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LOCAL_PKG="${HOME}/.local/share/typst/packages/local"
TYPST_PACKAGES="${TYPST_PACKAGES_DIR:-${HOME}/Repos/typst-packages}"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
die() { echo -e "${RED}Error:${NC} $*" >&2; exit 1; }
info() { echo -e "${BLUE}→${NC} $*"; }
ok() { echo -e "${GREEN}✓${NC} $*"; }
warn() { echo -e "${YELLOW}⚠${NC} $*"; }

# Link $2 → $1 at $LOCAL_PKG/$2name/$version, replacing any stale/dangling link.
link_pkg() {
    local src="$1" dest="$2"
    [[ -d "$src" ]] || { warn "source missing, skipping: $src"; return 1; }
    mkdir -p "$(dirname "$dest")"
    if [[ -L "$dest" || -e "$dest" ]]; then
        rm -rf "$dest"
    fi
    ln -s "$src" "$dest"
    ok "linked ${dest#"$LOCAL_PKG"/} → $src"
}

main() {
    info "Linking @local Typst packages into $LOCAL_PKG"

    # Canonical package from the typst-packages repo
    if [[ -d "$TYPST_PACKAGES/packages/lab-report" ]]; then
        link_pkg "$TYPST_PACKAGES/packages/lab-report/1.0.0" "$LOCAL_PKG/lab-report/1.0.0" || true
        link_pkg "$TYPST_PACKAGES/packages/lab-report/2.0.0" "$LOCAL_PKG/lab-report/2.0.0" || true
    else
        warn "typst-packages repo not found at $TYPST_PACKAGES"
        warn "  clone it: git clone git@github.com:atalariq/typst-packages.git $TYPST_PACKAGES"
        warn "  (or set TYPST_PACKAGES_DIR to its location)"
    fi

    # Backward compatibility: existing reports still import @local/report:1.0.0
    link_pkg "$REPO_ROOT/.templates/report-typst" "$LOCAL_PKG/report/1.0.0" || true

    echo ""
    ok "Done. Verify with: typst compile <some-report>/report.typ"
}

main "$@"
